# For docker compose: copy to .env next to compose.yaml. In Portainer: enter these under "Environment variables"
# (or use "Load variables from .env file"). Never commit .env.

AUTH_USERNAME=admin

# Either the password itself (at least 8 characters; avoid the $ sign, Compose treats it as a variable)...
AUTH_PASSWORD=change-me-to-something-long

# ...or, better, only its hash (then leave AUTH_PASSWORD empty). In Portainer: open the running container's
# Console (/bin/sh) and run:  node server/hash-password.js
# AUTH_PASSWORD_HASH=scrypt:32768:8:1:...

# Port on the host
HOST_PORT=8080

# "true" when the app is reached over HTTPS (behind a reverse proxy); the cookie is then HTTPS-only.
COOKIE_SECURE=false
# "true" only behind a reverse proxy that sets X-Forwarded-For (so the login lockout sees real addresses).
TRUST_PROXY=false

# Image to run; pin a version (e.g. ghcr.io/rafal-hacus/plotter-cutter:0.3.0) to update only when you choose.
IMAGE=ghcr.io/rafal-hacus/plotter-cutter:latest
