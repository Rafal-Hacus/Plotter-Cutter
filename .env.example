# Copy to .env next to compose.yaml and fill in. Never commit .env.
AUTH_USERNAME=admin

# Either the password itself (at least 8 characters)...
AUTH_PASSWORD=change-me-to-something-long

# ...or, better, only its hash (then remove AUTH_PASSWORD). Make one with:
#   docker compose run --rm -it plotter-cutter node server/hash-password.js
# Keep the single quotes: the hash contains $ signs.
# AUTH_PASSWORD_HASH='scrypt$32768$8$1$...'

# "true" when the app is reached over HTTPS (behind a reverse proxy); the cookie is then HTTPS-only.
COOKIE_SECURE=false
# "true" only behind a reverse proxy that sets X-Forwarded-For (so the login lockout sees real addresses).
TRUST_PROXY=false
