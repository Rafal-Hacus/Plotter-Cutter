{
  "name": "plotter-cutter",
  "private": true,
  "version": "0.2.0",
  "description": "Print-and-cut sheet builder for Skycut plotters (stickers, cards, CardXtra, guillotine, vinyl, PLT).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "hash-password": "node server/hash-password.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@expo-google-fonts/great-vibes": "0.4.1",
    "@expo-google-fonts/montserrat": "0.4.2",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@upscalerjs/esrgan-thick": "1.0.0",
    "migan-onnx": "1.0.0",
    "onnxruntime-web": "1.31.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.14.0",
    "globals": "17.4.0",
    "jsdom": "26.1.0",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "@upscalerjs/esrgan-thick": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  }
}
